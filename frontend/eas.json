{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "node": "22.16.0",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_API_URL": "https://api.zippcart.online/api/v1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
